APP_NAME=Cadence
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The private Tailscale URL of the VM (from `tailscale serve status`), e.g. https://cadence.tailXXXX.ts.net
APP_URL=https://CHANGE-ME.ts.net
# REQUIRED behind the Tailscale HTTPS proxy: forces asset URLs to the public
# https host. Without it Laravel emits http://127.0.0.1:8000/build/... which the
# browser blocks (mixed content) → white screen. Set it to the same value as APP_URL.
ASSET_URL=https://CHANGE-ME.ts.net
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Logs go to the container's stderr (visible via `docker compose logs`).
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# SQLite on the persistent /data volume (also set in the image).
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite

# Sessions/cache live in SQLite (persisted); jobs run inline (no worker).
SESSION_DRIVER=database
SESSION_LIFETIME=525600
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Coach IA (optional) — set your key to enable the AI coach features.
ANTHROPIC_API_KEY=
