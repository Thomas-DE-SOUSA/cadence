includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    excludePaths:
        # External LLM boundary: dynamically-typed API responses.
        - src/Activity/Infrastructure/Ai/ClaudeStravaTextParser.php
        - src/Training/Infrastructure/Ai/ClaudeCyclePlanner.php
    tmpDir: build/phpstan
