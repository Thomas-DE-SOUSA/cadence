includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    excludePaths:
        # External LLM boundary: dynamically-typed API responses.
        - src/Shared/Infrastructure/Ai/GeminiClient.php
        - src/Coaching/Infrastructure/Ai/AdvisorStreamer.php
        - src/Coaching/Infrastructure/Ai/GeminiCoachStreamer.php
        - src/Training/Infrastructure/Ai/GeminiCyclePlanner.php
        - src/Activity/Infrastructure/Ai/GeminiStravaTextParser.php
        - src/Activity/Infrastructure/Ai/GeminiActivityPhotoParser.php
    tmpDir: build/phpstan
